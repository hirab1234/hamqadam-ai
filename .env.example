# =========================================================================== #
# Hamqadam AI Verification Service - environment template.
#
#   cp .env.example .env
#
# Every key here overrides the matching YAML path in configs/.
# Nesting uses a DOUBLE underSCORE:  HQ_SERVER__PORT -> server.port
# Never commit a populated .env.
# =========================================================================== #

# --- Which config overlay to load: configs/app.<environment>.yaml ---------- #
HQ_APP__ENVIRONMENT=development
HQ_APP__DEBUG=false

# --- HTTP server ----------------------------------------------------------- #
HQ_SERVER__HOST=0.0.0.0
HQ_SERVER__PORT=8000
HQ_SERVER__WORKERS=1
HQ_SERVER__REQUEST_TIMEOUT_SECONDS=45

# --- Security -------------------------------------------------------------- #
# Comma-separated. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
HQ_SECURITY__API_KEYS=replace-me-with-a-real-key
HQ_SECURITY__REQUIRE_API_KEY=true
HQ_SECURITY__HMAC__ENABLED=false
HQ_SECURITY__HMAC__SECRET=
HQ_SECURITY__RATE_LIMIT__REQUESTS_PER_MINUTE=120
HQ_SECURITY__RATE_LIMIT__ANALYZE_REQUESTS_PER_MINUTE=40

# --- Runtime / hardware ---------------------------------------------------- #
# auto | cpu | cuda | tensorrt | directml | coreml
HQ_RUNTIME__DEVICE=auto
HQ_RUNTIME__GPU_DEVICE_ID=0
HQ_RUNTIME__INTRA_OP_THREADS=0
HQ_RUNTIME__INFERENCE_WORKERS=4
HQ_RUNTIME__MAX_BATCH_SIZE=8
HQ_RUNTIME__WARMUP_ON_STARTUP=true

# --- Storage --------------------------------------------------------------- #
HQ_STORAGE__MODEL_DIR=./model_store
HQ_STORAGE__TEMP_DIR=
HQ_STORAGE__TEMP_TTL_SECONDS=300
HQ_STORAGE__SECURE_DELETE=true

# --- Logging --------------------------------------------------------------- #
HQ_LOGGING__LEVEL=INFO
# json | console
HQ_LOGGING__RENDERER=json
HQ_LOGGING__REDACTION__ENABLED=true

# --- Observability --------------------------------------------------------- #
HQ_OBSERVABILITY__METRICS__ENABLED=true
HQ_OBSERVABILITY__MLFLOW__ENABLED=false
HQ_OBSERVABILITY__MLFLOW__TRACKING_URI=http://mlflow:5000

# --- External services (wired in later modules) ---------------------------- #
# Module 8 - Qdrant vector database
# The gallery is in-memory unless this is set: it is lost on restart and not
# shared between replicas. Any deployment running more than one worker needs
# qdrant.
HQ_DUPLICATE__BACKEND=memory
HQ_DUPLICATE__QDRANT__URL=http://qdrant:6333
HQ_DUPLICATE__QDRANT__API_KEY=
HQ_DUPLICATE__QDRANT__COLLECTION=hamqadam_face_embeddings

# Module 3/9 - Redis (embedding cache + attempt counters + rate limit)
HQ_REDIS__URL=redis://redis:6379/0
# Redis credentials belong inside the URL (redis://:password@host:6379/0).
# There is no separate password setting, and HQ_REDIS__PASSWORD was silently
# ignored - an unrecognised HQ_ variable is discarded, not rejected.

# Module 10 - RabbitMQ (async verification queue)
HQ_QUEUE__URL=amqp://hamqadam:hamqadam@rabbitmq:5672/
HQ_QUEUE__REQUEST_QUEUE=verification.requests
HQ_QUEUE__REPLY_QUEUE=verification.results
